{
  "name": "rosa-reticula",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-local workbench for Rosa Reticula: Bayer-inspired ordered dithering, selective screening, and duotone.",
  "license": "GPL-3.0",
  "author": {
    "email": "rosagus.contato@protonmail.com",
    "name": "rosa gus",
    "url": "https://github.com/rosagus"
  },
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run locales:check && tsc && vite build",
    "preview": "vite preview",
    "test": "npm run locales:check && node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "fixtures": "python3 -B scripts/generate_fixtures.py",
    "locales:format": "node scripts/generate_locale_types.mjs --format",
    "locales:generate": "node scripts/generate_locale_types.mjs",
    "locales:check": "node scripts/generate_locale_types.mjs --check"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "detect-libc": "^2.1.2",
    "fdir": "^6.5.0",
    "lightningcss": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0",
    "nanoid": "^3.3.20",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.32",
    "rolldown": "^1.2.16",
    "source-map-js": "^1.2.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "linkedom": "^0.18.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
